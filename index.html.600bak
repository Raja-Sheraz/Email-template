<style>
  /* Har section Figma ke APNE SVG export se kaata gaya hai, 2x par render
     kar ke. Yani yeh design ka hu-ba-hu aks hai. Headings tasveer mein
     isi liye hain ke email clients custom font (56th Street) load nahi karte. */
  body{margin:0;padding:0;background:#FFFFFF}
  img{-ms-interpolation-mode:bicubic}
  a{text-decoration:none}
  /* Tang screen par table ko 600px par jama nahi rehna chahiye, warna
     woh kinare se bahar nikal jata hai aur Gmail poore email ko chhota
     kar ke dikhata hai. */
  @media only screen and (max-width:620px){
    .wrap{width:100%!important;max-width:100%!important}
  }
</style>
</head>
